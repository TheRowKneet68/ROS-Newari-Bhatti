generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // user / admin / superadmin
  createdAt DateTime @default(now())
}



enum Role {
  OWNER
  ADMIN
  USER
}
